{
  "name": "comparison",
  "description": "Two columns compared (old vs new, them vs you)",
  "frame": "full",
  "fields": ["leftTitle", "left", "rightTitle", "right"],
  "html": "<div class=\"tpl-cmp\"><div class=\"tpl-cmp-col\"><div class=\"tpl-cmp-title\">{{leftTitle}}</div><div class=\"tpl-cmp-body\">{{left}}</div></div><div class=\"tpl-cmp-col\"><div class=\"tpl-cmp-title\">{{rightTitle}}</div><div class=\"tpl-cmp-body\">{{right}}</div></div></div>",
  "css": ".tpl-cmp{width:100%;height:100%;display:flex;align-items:stretch;justify-content:center;gap:calc(var(--u)*40px)}.tpl-cmp-col{flex:1;box-sizing:border-box;background:var(--brand-blue);border-radius:calc(var(--u)*16px);padding:calc(var(--u)*40px) calc(var(--u)*36px);display:flex;flex-direction:column;justify-content:center;box-shadow:0 calc(var(--u)*14px) calc(var(--u)*40px) rgba(0,0,0,.35)}.tpl-cmp-title{font-family:var(--brand-display);font-weight:900;font-size:calc(var(--u)*36px);color:var(--brand-orange);margin-bottom:calc(var(--u)*14px);text-transform:uppercase;letter-spacing:.02em}.tpl-cmp-body{font-family:var(--brand-body);font-weight:600;font-size:calc(var(--u)*30px);line-height:1.45;color:var(--brand-text);white-space:pre-line}"
}
