{
  "name": "quote-card",
  "description": "A pull quote with attribution",
  "frame": "center",
  "fields": ["quote", "author"],
  "html": "<div class=\"tpl-quote\"><div class=\"tpl-quote-mark\">&ldquo;</div><div class=\"tpl-quote-text\">{{quote}}</div><div class=\"tpl-quote-author\">{{author}}</div></div>",
  "css": ".tpl-quote{display:flex;flex-direction:column;justify-content:center;background:var(--brand-blue);border-radius:calc(var(--u)*18px);padding:calc(var(--u)*44px) calc(var(--u)*56px);box-shadow:0 calc(var(--u)*18px) calc(var(--u)*50px) rgba(0,0,0,.35);max-width:calc(var(--u)*820px)}.tpl-quote-mark{font-family:var(--brand-display);font-weight:900;font-size:calc(var(--u)*90px);line-height:.6;color:var(--brand-orange)}.tpl-quote-text{margin-top:calc(var(--u)*14px);font-family:var(--brand-body);font-weight:600;font-size:calc(var(--u)*40px);line-height:1.3;color:var(--brand-text)}.tpl-quote-author{margin-top:calc(var(--u)*18px);font-family:var(--brand-display);font-weight:700;font-size:calc(var(--u)*26px);color:var(--brand-orange)}"
}
