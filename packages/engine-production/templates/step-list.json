{
  "name": "step-list",
  "description": "A short titled list of steps, one per line",
  "frame": "center",
  "fields": ["title", "steps"],
  "html": "<div class=\"tpl-steps\"><div class=\"tpl-steps-title\">{{title}}</div><div class=\"tpl-steps-body\">{{steps}}</div></div>",
  "css": ".tpl-steps{background:var(--brand-blue);border-radius:calc(var(--u)*18px);padding:calc(var(--u)*40px) calc(var(--u)*52px);box-shadow:0 calc(var(--u)*18px) calc(var(--u)*50px) rgba(0,0,0,.35);max-width:calc(var(--u)*860px)}.tpl-steps-title{font-family:var(--brand-display);font-weight:800;font-size:calc(var(--u)*40px);color:var(--brand-orange);margin-bottom:calc(var(--u)*16px)}.tpl-steps-body{font-family:var(--brand-body);font-weight:600;font-size:calc(var(--u)*34px);line-height:1.55;color:var(--brand-text);white-space:pre-line}"
}
