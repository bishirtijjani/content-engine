{
  "name": "before-after",
  "description": "Two panels side by side: before and after",
  "frame": "full",
  "fields": ["beforeTitle", "before", "afterTitle", "after"],
  "html": "<div class=\"tpl-ba\"><div class=\"tpl-ba-panel tpl-ba-before\"><div class=\"tpl-ba-title\">{{beforeTitle}}</div><div class=\"tpl-ba-body\">{{before}}</div></div><div class=\"tpl-ba-panel tpl-ba-after\"><div class=\"tpl-ba-title\">{{afterTitle}}</div><div class=\"tpl-ba-body\">{{after}}</div></div></div>",
  "css": ".tpl-ba{width:100%;height:100%;display:flex;align-items:stretch;justify-content:center;gap:calc(var(--u)*40px)}.tpl-ba-panel{flex:1;box-sizing:border-box;border-radius:calc(var(--u)*16px);padding:calc(var(--u)*40px) calc(var(--u)*36px);display:flex;flex-direction:column;justify-content:center;box-shadow:0 calc(var(--u)*14px) calc(var(--u)*40px) rgba(0,0,0,.35)}.tpl-ba-before{background:var(--brand-blue)}.tpl-ba-after{background:var(--brand-orange)}.tpl-ba-title{font-family:var(--brand-display);font-weight:900;font-size:calc(var(--u)*36px);color:var(--brand-text);margin-bottom:calc(var(--u)*14px);text-transform:uppercase;letter-spacing:.02em}.tpl-ba-body{font-family:var(--brand-body);font-weight:600;font-size:calc(var(--u)*30px);line-height:1.4;color:var(--brand-text)}"
}
