{
  "name": "content-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Full content automation engine — content database + 5 independent engines + 3 human gates",
  "workspaces": [
    "packages/*",
    "ui"
  ],
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test \"packages/*/test/*.test.js\" \"ui/test/*.test.mjs\"",
    "test:core": "node --disable-warning=ExperimentalWarning --test packages/core/test/",
    "ui": "node --disable-warning=ExperimentalWarning ui/server.mjs",
    "test:content": "node --disable-warning=ExperimentalWarning --test packages/engine-content/test/",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed-brand.mjs && node --disable-warning=ExperimentalWarning scripts/seed-script-framework.mjs && node --disable-warning=ExperimentalWarning scripts/seed-idea-framework.mjs",
    "demo": "node --disable-warning=ExperimentalWarning demo.mjs",
    "smoke": "node --disable-warning=ExperimentalWarning scripts/smoke-pipeline.mjs",
    "reset": "node --disable-warning=ExperimentalWarning scripts/reset-content.mjs",
    "clean": "node --disable-warning=ExperimentalWarning packages/engine-production/tools/clean/clean.mjs",
    "icons": "node --disable-warning=ExperimentalWarning packages/engine-production/tools/build-icons.mjs",
    "gallery": "node --disable-warning=ExperimentalWarning packages/engine-production/tools/diagram-gallery.mjs"
  }
}
